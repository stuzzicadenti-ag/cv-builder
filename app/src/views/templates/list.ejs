<%- include('../partials/header') %>

<div class="fade-in-up" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
  <div class="page-header">
    <h1><%= t('templates.title') %></h1>
    <p style="font-size:0.9rem;"><%= t('templates.subtitle') %></p>
  </div>
  <% if (typeof user !== 'undefined' && user) { %>
    <a href="/cv" class="btn btn-outline btn-sm"><%= t('nav.myCvs') %></a>
  <% } %>
</div>

<% if (templates.length === 0) { %>
  <div class="card empty-state-card fade-in-up">
    <span class="icon">&#127912;</span>
    <h2 style="margin-bottom:8px; font-size:1.2rem;"><%= t('templates.noTemplates') %></h2>
    <p style="color:var(--text-muted);"><%= t('templates.noTemplatesDesc') %></p>
  </div>
<% } else { %>
  <div class="grid grid-3">
    <% const previewStyles = {
      'Classic': { bg: '#f8fafc', accent: '#1e293b', accentHex: '1e293b', badge: null },
      'Modern': { bg: '#eff6ff', accent: '#2563eb', accentHex: '2563eb', badge: 'Popular' },
      'Minimal': { bg: '#f9fafb', accent: '#6b7280', accentHex: '6b7280', badge: null }
    }; %>
    <% for (const tpl of templates) { %>
      <% const style = previewStyles[tpl.name] || { bg: '#f1f5f9', accent: '#6366f1', accentHex: '6366f1', badge: null }; %>
      <div class="card card-interactive tpl-card fade-in-up" style="overflow:hidden; padding:0;">
        <!-- Template preview -->
        <div class="tpl-preview" style="background:<%= style.bg %>;">
          <% if (style.badge) { %>
            <span class="badge badge-primary" style="position:absolute; top:12px; right:12px;"><%= style.badge %></span>
          <% } %>
          <div class="tpl-preview-doc" style="border-color:<%= style.accent %>;">
            <div class="tpl-preview-line" style="top:8px; height:3px; background:<%= style.accent %>;"></div>
            <div class="tpl-preview-line" style="top:16px; right:12px; background:<%= style.accent %>20;"></div>
            <div class="tpl-preview-line" style="top:22px; right:14px; background:<%= style.accent %>20;"></div>
            <div class="tpl-preview-line" style="top:32px; height:2px; background:<%= style.accent %>;  right:24px;"></div>
            <div class="tpl-preview-line" style="top:38px; right:10px; height:2px; background:<%= style.accent %>15;"></div>
            <div class="tpl-preview-line" style="top:44px; right:16px; height:2px; background:<%= style.accent %>15;"></div>
            <div class="tpl-preview-line" style="top:54px; height:2px; background:<%= style.accent %>; right:28px;"></div>
            <div class="tpl-preview-line" style="top:60px; right:12px; height:2px; background:<%= style.accent %>15;"></div>
            <div class="tpl-preview-line" style="top:66px; right:18px; height:2px; background:<%= style.accent %>15;"></div>
            <div class="tpl-preview-line" style="top:76px; right:8px; height:2px; background:<%= style.accent %>10;"></div>
          </div>
        </div>
        <div style="padding:20px;">
          <h3 style="margin-bottom:6px; font-size:1.05rem;"><%= tpl.name %></h3>
          <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:16px; min-height:40px; line-height:1.5;"><%= tpl.description %></p>
          <div style="display:flex; gap:8px;">
            <a href="/cv/new?template=<%= tpl.id %>" class="btn btn-primary btn-sm" style="flex:1; text-align:center;"><%= t('templates.useTemplate') %></a>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<%- include('../partials/footer') %>
