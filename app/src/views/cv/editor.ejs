<%- include('../partials/header') %>

<%
  const cvData = cv && cv.data ? (typeof cv.data === 'string' ? JSON.parse(cv.data) : cv.data) : {};
  const name = cvData.name || '';
  const email = cvData.email || '';
  const phone = cvData.phone || '';
  const location = cvData.location || '';
  const linkedin = cvData.linkedin || '';
  const website = cvData.website || '';
  const nationality = cvData.nationality || '';
  const dateOfBirth = cvData.dateOfBirth || '';
  const drivingLicense = cvData.drivingLicense || '';
  const summary = cvData.summary || '';
  const experience = cvData.experience || [];
  const education = cvData.education || [];
  const skills = cvData.skills || [];
  const languages = cvData.languages || [];
  const certifications = cvData.certifications || [];
  const projects = cvData.projects || [];
  const volunteer = cvData.volunteer || [];
  const references = cvData.references || [];
%>

<div class="fade-in-up" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
  <div class="page-header">
    <h1><%= cv ? t('cv.editCv') : t('cv.newCv') %></h1>
    <span class="autosave-indicator" id="save-indicator">
      <span class="autosave-dot"></span>
      <span class="autosave-text">Unsaved changes</span>
    </span>
  </div>
  <div style="display:flex; gap:8px; align-items:center;">
    <% if (cv && cv.id) { %>
      <a href="/cv/preview/<%= cv.id %>" class="btn btn-outline btn-sm" target="_blank">&#128065; <%= t('cv.preview') %></a>
    <% } %>
    <a href="/cv" class="btn btn-outline btn-sm"><%= t('cv.backToMyCvs') %></a>
  </div>
</div>

<!-- Progress indicator -->
<div class="editor-progress" id="editor-progress">
  <span>Completion:</span>
  <div class="editor-progress-bar">
    <div class="editor-progress-fill" id="progress-fill" style="width:0%"></div>
  </div>
  <span class="editor-progress-text" id="progress-text">0%</span>
</div>

<form id="cv-form" method="POST" action="/cv/save">
  <% if (cv) { %>
    <input type="hidden" name="id" value="<%= cv.id %>">
  <% } %>
  <input type="hidden" name="data" id="cv-data-field" value="">

  <!-- Basic Info -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#128221;</div>
        <h2><%= t('cv.basicInfo') %></h2>
      </div>
    </div>
    <div class="form-group">
      <label for="cv-title"><%= t('cv.cvTitle') %></label>
      <input type="text" id="cv-title" name="title" required value="<%= cv ? cv.title : 'My CV' %>" placeholder="<%= t('cv.cvTitlePlaceholder') %>">
      <span class="form-hint">Give your CV a name to identify it easily</span>
    </div>
    <div class="form-group">
      <label for="cv-template"><%= t('cv.template') %></label>
      <select id="cv-template" name="templateId" required>
        <% for (const tpl of templates) { %>
          <option value="<%= tpl.id %>" <%= (cv && cv.templateId === tpl.id) ? 'selected' : '' %>><%= tpl.name %> - <%= tpl.description %></option>
        <% } %>
      </select>
    </div>
  </div>

  <!-- Personal Details -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#128100;</div>
        <h2><%= t('cv.personalDetails') %></h2>
      </div>
    </div>
    <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <div class="form-group">
        <label for="cv-name"><%= t('cv.fullName') %></label>
        <input type="text" id="cv-name" data-field="name" value="<%= name %>" placeholder="John Doe">
      </div>
      <div class="form-group">
        <label for="cv-email"><%= t('cv.email') %></label>
        <input type="email" id="cv-email" data-field="email" value="<%= email %>" placeholder="john@example.com">
      </div>
      <div class="form-group">
        <label for="cv-phone"><%= t('cv.phone') %></label>
        <input type="tel" id="cv-phone" data-field="phone" value="<%= phone %>" placeholder="+41 79 123 45 67">
      </div>
      <div class="form-group">
        <label for="cv-location"><%= t('cv.location') %></label>
        <input type="text" id="cv-location" data-field="location" value="<%= location %>" placeholder="Zurich, Switzerland">
      </div>
      <div class="form-group">
        <label for="cv-linkedin"><%= t('cv.linkedin') %></label>
        <input type="url" id="cv-linkedin" data-field="linkedin" value="<%= linkedin %>" placeholder="<%= t('cv.linkedinPlaceholder') %>">
      </div>
      <div class="form-group">
        <label for="cv-website"><%= t('cv.website') %></label>
        <input type="url" id="cv-website" data-field="website" value="<%= website %>" placeholder="<%= t('cv.websitePlaceholder') %>">
      </div>
    </div>
    <details>
      <summary><%= t('cv.additionalPersonal') %></summary>
      <div>
        <div class="editor-grid-3" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;">
          <div class="form-group" style="margin-bottom:0;">
            <label for="cv-nationality"><%= t('cv.nationality') %></label>
            <input type="text" id="cv-nationality" data-field="nationality" value="<%= nationality %>" placeholder="<%= t('cv.nationalityPlaceholder') %>">
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="cv-dob"><%= t('cv.dateOfBirth') %></label>
            <input type="text" id="cv-dob" data-field="dateOfBirth" value="<%= dateOfBirth %>" placeholder="<%= t('cv.dateOfBirthPlaceholder') %>">
          </div>
          <div class="form-group" style="margin-bottom:0;">
            <label for="cv-driving"><%= t('cv.drivingLicense') %></label>
            <input type="text" id="cv-driving" data-field="drivingLicense" value="<%= drivingLicense %>" placeholder="<%= t('cv.drivingLicensePlaceholder') %>">
          </div>
        </div>
      </div>
    </details>
    <div class="form-group" style="margin-top:16px;">
      <label for="cv-summary"><%= t('cv.summary') %></label>
      <textarea id="cv-summary" data-field="summary" rows="3" placeholder="<%= t('cv.summaryPlaceholder') %>"><%= summary %></textarea>
      <span class="form-hint" id="summary-count"><%= summary.length %>/500 characters</span>
    </div>
  </div>

  <!-- Experience -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#128188;</div>
        <h2><%= t('cv.experience') %></h2>
        <span class="editor-section-count" id="exp-count"><%= experience.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addExperience()">+ <%= t('cv.add') %></button>
    </div>
    <div id="experience-list">
      <% if (experience.length > 0) { %>
        <% experience.forEach((job, i) => { %>
          <div class="editor-entry exp-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.jobTitle') %></label>
                <input type="text" class="exp-title" value="<%= job.title %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.company') %></label>
                <input type="text" class="exp-company" value="<%= job.company %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.dates') %></label>
              <input type="text" class="exp-dates" value="<%= job.dates %>" placeholder="Jan 2023 - Present">
            </div>
            <div class="form-group">
              <label><%= t('cv.description') %></label>
              <textarea class="exp-description" rows="3" placeholder="<%= t('cv.descriptionPlaceholder') %>"><%= job.description %></textarea>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% if (experience.length === 0) { %>
    <div class="empty-section" id="exp-empty" style="text-align:center; padding:20px; color:var(--text-muted); font-size:0.85rem;">
      No experience added yet. Click "+ Add" to get started.
    </div>
    <% } %>
  </div>

  <!-- Education -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#127891;</div>
        <h2><%= t('cv.education') %></h2>
        <span class="editor-section-count" id="edu-count"><%= education.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addEducation()">+ <%= t('cv.add') %></button>
    </div>
    <div id="education-list">
      <% if (education.length > 0) { %>
        <% education.forEach((edu, i) => { %>
          <div class="editor-entry edu-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.degree') %></label>
                <input type="text" class="edu-degree" value="<%= edu.degree %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.school') %></label>
                <input type="text" class="edu-school" value="<%= edu.school %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.dates') %></label>
              <input type="text" class="edu-dates" value="<%= edu.dates %>" placeholder="Sep 2018 - Jun 2022">
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% if (education.length === 0) { %>
    <div class="empty-section" id="edu-empty" style="text-align:center; padding:20px; color:var(--text-muted); font-size:0.85rem;">
      No education added yet. Click "+ Add" to get started.
    </div>
    <% } %>
  </div>

  <!-- Skills -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#9889;</div>
        <h2><%= t('cv.skills') %></h2>
      </div>
    </div>
    <div class="form-group">
      <label for="cv-skills"><%= t('cv.skillsLabel') %></label>
      <input type="text" id="cv-skills" value="<%= skills.join(', ') %>" placeholder="JavaScript, Python, Project Management, ...">
      <span class="form-hint">Separate skills with commas</span>
    </div>
    <% if (skills.length > 0) { %>
    <div id="skills-preview" style="display:flex; flex-wrap:wrap; gap:6px; margin-top:4px;">
      <% skills.forEach(function(s) { %>
        <span class="badge badge-primary"><%= s %></span>
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- Languages -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#127760;</div>
        <h2><%= t('cv.languages') %></h2>
        <span class="editor-section-count" id="lang-count"><%= languages.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addLanguage()">+ <%= t('cv.add') %></button>
    </div>
    <div id="language-list">
      <% if (languages.length > 0) { %>
        <% languages.forEach((lang, i) => { %>
          <div class="editor-entry lang-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.languageName') %></label>
                <input type="text" class="lang-name" value="<%= lang.name %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.languageLevel') %></label>
                <select class="lang-level">
                  <option value="" <%= !lang.level ? 'selected' : '' %>>-</option>
                  <option value="Native" <%= lang.level === 'Native' ? 'selected' : '' %>><%= t('cv.langNative') %></option>
                  <option value="C2" <%= lang.level === 'C2' ? 'selected' : '' %>>C2 - <%= t('cv.langC2') %></option>
                  <option value="C1" <%= lang.level === 'C1' ? 'selected' : '' %>>C1 - <%= t('cv.langC1') %></option>
                  <option value="B2" <%= lang.level === 'B2' ? 'selected' : '' %>>B2 - <%= t('cv.langB2') %></option>
                  <option value="B1" <%= lang.level === 'B1' ? 'selected' : '' %>>B1 - <%= t('cv.langB1') %></option>
                  <option value="A2" <%= lang.level === 'A2' ? 'selected' : '' %>>A2 - <%= t('cv.langA2') %></option>
                  <option value="A1" <%= lang.level === 'A1' ? 'selected' : '' %>>A1 - <%= t('cv.langA1') %></option>
                </select>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Certifications -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#127942;</div>
        <h2><%= t('cv.certifications') %></h2>
        <span class="editor-section-count" id="cert-count"><%= certifications.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addCertification()">+ <%= t('cv.add') %></button>
    </div>
    <div id="certification-list">
      <% if (certifications.length > 0) { %>
        <% certifications.forEach((cert, i) => { %>
          <div class="editor-entry cert-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.certName') %></label>
                <input type="text" class="cert-name" value="<%= cert.name %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.certIssuer') %></label>
                <input type="text" class="cert-issuer" value="<%= cert.issuer %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.certDate') %></label>
              <input type="text" class="cert-date" value="<%= cert.date %>" placeholder="March 2024">
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Projects -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#128187;</div>
        <h2><%= t('cv.projects') %></h2>
        <span class="editor-section-count" id="proj-count"><%= projects.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addProject()">+ <%= t('cv.add') %></button>
    </div>
    <div id="project-list">
      <% if (projects.length > 0) { %>
        <% projects.forEach((proj, i) => { %>
          <div class="editor-entry proj-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.projectName') %></label>
                <input type="text" class="proj-name" value="<%= proj.name %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.projectUrl') %></label>
                <input type="text" class="proj-url" value="<%= proj.url %>" placeholder="<%= t('cv.projectUrlPlaceholder') %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.projectTech') %></label>
              <input type="text" class="proj-tech" value="<%= proj.tech %>" placeholder="<%= t('cv.projectTechPlaceholder') %>">
            </div>
            <div class="form-group">
              <label><%= t('cv.description') %></label>
              <textarea class="proj-description" rows="2" placeholder="<%= t('cv.projectDescPlaceholder') %>"><%= proj.description %></textarea>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Volunteer -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#129309;</div>
        <h2><%= t('cv.volunteer') %></h2>
        <span class="editor-section-count" id="vol-count"><%= volunteer.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addVolunteer()">+ <%= t('cv.add') %></button>
    </div>
    <div id="volunteer-list">
      <% if (volunteer.length > 0) { %>
        <% volunteer.forEach((vol, i) => { %>
          <div class="editor-entry vol-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.volunteerRole') %></label>
                <input type="text" class="vol-role" value="<%= vol.role %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.volunteerOrg') %></label>
                <input type="text" class="vol-organization" value="<%= vol.organization %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.dates') %></label>
              <input type="text" class="vol-dates" value="<%= vol.dates %>">
            </div>
            <div class="form-group">
              <label><%= t('cv.description') %></label>
              <textarea class="vol-description" rows="2"><%= vol.description %></textarea>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- References -->
  <div class="card editor-card fade-in-up" style="margin-bottom:20px;">
    <div class="editor-section-header">
      <div class="editor-section-title">
        <div class="editor-section-icon">&#128101;</div>
        <h2><%= t('cv.references') %></h2>
        <span class="editor-section-count" id="ref-count"><%= references.length %></span>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addReference()">+ <%= t('cv.add') %></button>
    </div>
    <div id="reference-list">
      <% if (references.length > 0) { %>
        <% references.forEach((ref, i) => { %>
          <div class="editor-entry ref-entry">
            <button type="button" class="btn btn-ghost btn-sm btn-remove" onclick="removeEntry(this)" title="Remove">&#10005;</button>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.refName') %></label>
                <input type="text" class="ref-name" value="<%= ref.name %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.refPosition') %></label>
                <input type="text" class="ref-position" value="<%= ref.position %>">
              </div>
            </div>
            <div class="editor-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.refCompany') %></label>
                <input type="text" class="ref-company" value="<%= ref.company %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.refContact') %></label>
                <input type="text" class="ref-contact" value="<%= ref.contact %>" placeholder="<%= t('cv.refContactPlaceholder') %>">
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <!-- Action bar -->
  <div class="card action-bar fade-in-up">
    <a href="/cv" class="btn btn-outline"><%= t('cv.cancel') %></a>
    <% if (cv && cv.id) { %>
      <a href="/cv/export/<%= cv.id %>" class="btn btn-outline btn-sm"><%= t('cv.exportJson') %></a>
    <% } %>
    <button type="submit" class="btn btn-primary btn-lg" id="save-btn">&#128190; <%= t('cv.save') %></button>
  </div>
</form>

<!-- PDF Preview modal (for existing CVs) -->
<% if (cv && cv.id) { %>
<div id="pdf-preview-container" style="display:none; position:fixed; inset:0; z-index:999; background:rgba(0,0,0,0.7); backdrop-filter:blur(4px);">
  <div style="position:absolute; inset:16px; background:var(--surface); border-radius:var(--radius-lg, 12px); display:flex; flex-direction:column; overflow:hidden;">
    <div style="display:flex; justify-content:space-between; align-items:center; padding:12px 20px; border-bottom:1px solid var(--border);">
      <h3>PDF Preview</h3>
      <button type="button" class="btn btn-ghost btn-sm" onclick="closePdfPreview()">&#10005; Close</button>
    </div>
    <iframe id="pdf-preview-frame" style="flex:1; border:none; background:#fff;"></iframe>
  </div>
</div>
<% } %>

<div class="toast-container" id="toast-container"></div>

<script>
function escAttr(s) {
  const d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML.replace(/"/g, '&quot;');
}

// Animated entry removal
function removeEntry(btn) {
  var entry = btn.closest('.editor-entry');
  entry.classList.add('removing');
  setTimeout(function() {
    entry.remove();
    updateCounts();
    updateProgress();
    markUnsaved();
  }, 250);
}

// Toast helper
function showToast(msg, type) {
  var container = document.getElementById('toast-container');
  var toast = document.createElement('div');
  toast.className = 'toast toast-' + (type || 'info');
  toast.textContent = msg;
  container.appendChild(toast);
  setTimeout(function() {
    toast.classList.add('toast-out');
    setTimeout(function() { toast.remove(); }, 300);
  }, 3000);
}

// Mark form as having unsaved changes
var hasUnsaved = false;
function markUnsaved() {
  hasUnsaved = true;
  var ind = document.getElementById('save-indicator');
  ind.className = 'autosave-indicator';
  ind.querySelector('.autosave-text').textContent = 'Unsaved changes';
}
function markSaved() {
  hasUnsaved = false;
  var ind = document.getElementById('save-indicator');
  ind.className = 'autosave-indicator saved';
  ind.querySelector('.autosave-text').textContent = 'All changes saved';
}

// Warn on page leave with unsaved changes
window.addEventListener('beforeunload', function(e) {
  if (hasUnsaved) {
    e.preventDefault();
    e.returnValue = '';
  }
});

// Listen to all form changes
document.getElementById('cv-form').addEventListener('input', function() {
  markUnsaved();
  updateProgress();
});

// Update section counts
function updateCounts() {
  var counts = {
    'exp-count': document.querySelectorAll('.exp-entry').length,
    'edu-count': document.querySelectorAll('.edu-entry').length,
    'lang-count': document.querySelectorAll('.lang-entry').length,
    'cert-count': document.querySelectorAll('.cert-entry').length,
    'proj-count': document.querySelectorAll('.proj-entry').length,
    'vol-count': document.querySelectorAll('.vol-entry').length,
    'ref-count': document.querySelectorAll('.ref-entry').length,
  };
  for (var id in counts) {
    var el = document.getElementById(id);
    if (el) el.textContent = counts[id];
  }
  // Hide/show empty states
  var expEmpty = document.getElementById('exp-empty');
  if (expEmpty) expEmpty.style.display = counts['exp-count'] > 0 ? 'none' : 'block';
  var eduEmpty = document.getElementById('edu-empty');
  if (eduEmpty) eduEmpty.style.display = counts['edu-count'] > 0 ? 'none' : 'block';
}

// Update progress bar
function updateProgress() {
  var fields = 0;
  var filled = 0;
  // Core personal fields
  ['cv-name', 'cv-email', 'cv-phone', 'cv-location', 'cv-summary'].forEach(function(id) {
    fields++;
    if (document.getElementById(id) && document.getElementById(id).value.trim()) filled++;
  });
  // Sections
  if (document.querySelectorAll('.exp-entry').length > 0) filled++;
  fields++;
  if (document.querySelectorAll('.edu-entry').length > 0) filled++;
  fields++;
  if (document.getElementById('cv-skills') && document.getElementById('cv-skills').value.trim()) filled++;
  fields++;

  var pct = Math.round((filled / fields) * 100);
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-text').textContent = pct + '%';
}

// Summary character counter
var summaryEl = document.getElementById('cv-summary');
if (summaryEl) {
  summaryEl.addEventListener('input', function() {
    document.getElementById('summary-count').textContent = this.value.length + '/500 characters';
  });
}

// Skills live preview
var skillsInput = document.getElementById('cv-skills');
if (skillsInput) {
  skillsInput.addEventListener('input', function() {
    var container = document.getElementById('skills-preview');
    if (!container) {
      container = document.createElement('div');
      container.id = 'skills-preview';
      container.style.cssText = 'display:flex; flex-wrap:wrap; gap:6px; margin-top:4px;';
      this.parentElement.appendChild(container);
    }
    var skills = this.value.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
    container.innerHTML = skills.map(function(s) {
      return '<span class="badge badge-primary">' + escAttr(s) + '</span>';
    }).join('');
  });
}

