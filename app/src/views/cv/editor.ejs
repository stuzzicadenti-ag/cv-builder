function collectFormData() {
  const experience = [];
  document.querySelectorAll('.exp-entry').forEach(entry => {
    const title = entry.querySelector('.exp-title')?.value?.trim() || '';
    const company = entry.querySelector('.exp-company')?.value?.trim() || '';
    const dates = entry.querySelector('.exp-dates')?.value?.trim() || '';
    const description = entry.querySelector('.exp-description')?.value?.trim() || '';
    if (title || company) experience.push({ title, company, dates, description });
  });

  const education = [];
  document.querySelectorAll('.edu-entry').forEach(entry => {
    const degree = entry.querySelector('.edu-degree')?.value?.trim() || '';
    const school = entry.querySelector('.edu-school')?.value?.trim() || '';
    const dates = entry.querySelector('.edu-dates')?.value?.trim() || '';
    if (degree || school) education.push({ degree, school, dates });
  });

  const languages = [];
  document.querySelectorAll('.lang-entry').forEach(entry => {
    const name = entry.querySelector('.lang-name')?.value?.trim() || '';
    const level = entry.querySelector('.lang-level')?.value || '';
    if (name) languages.push({ name, level });
  });

  const certifications = [];
  document.querySelectorAll('.cert-entry').forEach(entry => {
    const name = entry.querySelector('.cert-name')?.value?.trim() || '';
    const issuer = entry.querySelector('.cert-issuer')?.value?.trim() || '';
    const date = entry.querySelector('.cert-date')?.value?.trim() || '';
    if (name) certifications.push({ name, issuer, date });
  });

  const projects = [];
  document.querySelectorAll('.proj-entry').forEach(entry => {
    const name = entry.querySelector('.proj-name')?.value?.trim() || '';
    const url = entry.querySelector('.proj-url')?.value?.trim() || '';
    const tech = entry.querySelector('.proj-tech')?.value?.trim() || '';
    const description = entry.querySelector('.proj-description')?.value?.trim() || '';
    if (name) projects.push({ name, url, tech, description });
  });

  const volunteer = [];
  document.querySelectorAll('.vol-entry').forEach(entry => {
    const role = entry.querySelector('.vol-role')?.value?.trim() || '';
    const organization = entry.querySelector('.vol-organization')?.value?.trim() || '';
    const dates = entry.querySelector('.vol-dates')?.value?.trim() || '';
    const description = entry.querySelector('.vol-description')?.value?.trim() || '';
    if (role || organization) volunteer.push({ role, organization, dates, description });
  });

  const references = [];
  document.querySelectorAll('.ref-entry').forEach(entry => {
    const name = entry.querySelector('.ref-name')?.value?.trim() || '';
    const position = entry.querySelector('.ref-position')?.value?.trim() || '';
    const company = entry.querySelector('.ref-company')?.value?.trim() || '';
    const contact = entry.querySelector('.ref-contact')?.value?.trim() || '';
    if (name) references.push({ name, position, company, contact });
  });

  const skillsRaw = document.getElementById('cv-skills').value;
  const skills = skillsRaw.split(',').map(s => s.trim()).filter(Boolean);

  return {
    name: document.getElementById('cv-name').value.trim(),
    email: document.getElementById('cv-email').value.trim(),
    phone: document.getElementById('cv-phone').value.trim(),
    location: document.getElementById('cv-location').value.trim(),
    linkedin: document.getElementById('cv-linkedin').value.trim(),
    website: document.getElementById('cv-website').value.trim(),
    nationality: document.getElementById('cv-nationality').value.trim(),
    dateOfBirth: document.getElementById('cv-dob').value.trim(),
    drivingLicense: document.getElementById('cv-driving').value.trim(),
    summary: document.getElementById('cv-summary').value.trim(),
    experience,
    education,
    skills,
    languages,
    certifications,
    projects,
    volunteer,
    references,
  };
}

document.getElementById('cv-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var saveBtn = document.getElementById('save-btn');
  saveBtn.classList.add('btn-loading');

  try {
    const data = collectFormData();

    // Basic validation
    var title = document.getElementById('cv-title').value.trim();
    if (!title) {
      showToast('Please enter a CV title', 'error');
      saveBtn.classList.remove('btn-loading');
      document.getElementById('cv-title').focus();
      return;
    }

    document.getElementById('cv-data-field').value = JSON.stringify(data);
    hasUnsaved = false; // Prevent beforeunload warning
    this.submit();
  } catch (err) {
    console.error('Failed to collect form data:', err);
    showToast('Failed to save. Please try again.', 'error');
    saveBtn.classList.remove('btn-loading');
  }
});

// Keyboard shortcut: Ctrl+S to save
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 's') {
    e.preventDefault();
    document.getElementById('save-btn').click();
  }
});

// Initialize progress on page load
updateProgress();

// Mark as saved on fresh load (no changes yet)
<% if (cv && cv.id) { %>
  markSaved();
<% } %>
</script>

