<%- include('../partials/header') %>

<%
  const cvData = cv && cv.data ? (typeof cv.data === 'string' ? JSON.parse(cv.data) : cv.data) : {};
  const name = cvData.name || '';
  const email = cvData.email || '';
  const phone = cvData.phone || '';
  const location = cvData.location || '';
  const summary = cvData.summary || '';
  const experience = cvData.experience || [];
  const education = cvData.education || [];
  const skills = cvData.skills || [];
%>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
  <h1><%= cv ? t('cv.editCv') : t('cv.newCv') %></h1>
  <a href="/cv" class="btn btn-outline btn-sm"><%= t('cv.backToMyCvs') %></a>
</div>

<form id="cv-form" method="POST" action="/cv/save">
  <% if (cv) { %>
    <input type="hidden" name="id" value="<%= cv.id %>">
  <% } %>
  <input type="hidden" name="data" id="cv-data-field" value="">

  <div class="card" style="margin-bottom:20px;">
    <h2 style="margin-bottom:16px;"><%= t('cv.basicInfo') %></h2>
    <div class="form-group">
      <label for="cv-title"><%= t('cv.cvTitle') %></label>
      <input type="text" id="cv-title" name="title" required value="<%= cv ? cv.title : 'My CV' %>" placeholder="<%= t('cv.cvTitlePlaceholder') %>">
    </div>
    <div class="form-group">
      <label for="cv-template"><%= t('cv.template') %></label>
      <select id="cv-template" name="templateId" required>
        <% for (const tpl of templates) { %>
          <option value="<%= tpl.id %>" <%= (cv && cv.templateId === tpl.id) ? 'selected' : '' %>><%= tpl.name %> - <%= tpl.description %></option>
        <% } %>
      </select>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <h2 style="margin-bottom:16px;"><%= t('cv.personalDetails') %></h2>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <div class="form-group">
        <label for="cv-name"><%= t('cv.fullName') %></label>
        <input type="text" id="cv-name" data-field="name" required value="<%= name %>">
      </div>
      <div class="form-group">
        <label for="cv-email"><%= t('cv.email') %></label>
        <input type="email" id="cv-email" data-field="email" required value="<%= email %>">
      </div>
      <div class="form-group">
        <label for="cv-phone"><%= t('cv.phone') %></label>
        <input type="text" id="cv-phone" data-field="phone" value="<%= phone %>">
      </div>
      <div class="form-group">
        <label for="cv-location"><%= t('cv.location') %></label>
        <input type="text" id="cv-location" data-field="location" value="<%= location %>">
      </div>
    </div>
    <div class="form-group">
      <label for="cv-summary"><%= t('cv.summary') %></label>
      <textarea id="cv-summary" data-field="summary" rows="3" placeholder="<%= t('cv.summaryPlaceholder') %>"><%= summary %></textarea>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h2><%= t('cv.experience') %></h2>
      <button type="button" class="btn btn-outline btn-sm" onclick="addExperience()"><%= t('cv.add') %></button>
    </div>
    <div id="experience-list">
      <% if (experience.length > 0) { %>
        <% experience.forEach((job, i) => { %>
          <div class="exp-entry" style="border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-bottom:12px; position:relative;">
            <button type="button" class="btn btn-danger btn-sm" style="position:absolute; top:8px; right:8px;" onclick="this.parentElement.remove()">X</button>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.jobTitle') %></label>
                <input type="text" class="exp-title" value="<%= job.title %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.company') %></label>
                <input type="text" class="exp-company" value="<%= job.company %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.dates') %></label>
              <input type="text" class="exp-dates" value="<%= job.dates %>">
            </div>
            <div class="form-group">
              <label><%= t('cv.description') %></label>
              <textarea class="exp-description" rows="3" placeholder="<%= t('cv.descriptionPlaceholder') %>"><%= job.description %></textarea>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h2><%= t('cv.education') %></h2>
      <button type="button" class="btn btn-outline btn-sm" onclick="addEducation()"><%= t('cv.add') %></button>
    </div>
    <div id="education-list">
      <% if (education.length > 0) { %>
        <% education.forEach((edu, i) => { %>
          <div class="edu-entry" style="border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-bottom:12px; position:relative;">
            <button type="button" class="btn btn-danger btn-sm" style="position:absolute; top:8px; right:8px;" onclick="this.parentElement.remove()">X</button>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div class="form-group">
                <label><%= t('cv.degree') %></label>
                <input type="text" class="edu-degree" value="<%= edu.degree %>">
              </div>
              <div class="form-group">
                <label><%= t('cv.school') %></label>
                <input type="text" class="edu-school" value="<%= edu.school %>">
              </div>
            </div>
            <div class="form-group">
              <label><%= t('cv.dates') %></label>
              <input type="text" class="edu-dates" value="<%= edu.dates %>">
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>

  <div class="card" style="margin-bottom:20px;">
    <h2 style="margin-bottom:16px;"><%= t('cv.skills') %></h2>
    <div class="form-group">
      <label for="cv-skills"><%= t('cv.skillsLabel') %></label>
      <input type="text" id="cv-skills" value="<%= skills.join(', ') %>">
    </div>
  </div>

  <div style="display:flex; gap:12px; justify-content:flex-end;">
    <a href="/cv" class="btn btn-outline"><%= t('cv.cancel') %></a>
    <button type="submit" class="btn btn-primary"><%= t('cv.save') %></button>
  </div>
</form>

<script>
function escAttr(s) {
  const d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML.replace(/"/g, '&quot;');
}

function createExpEntry(data = {}) {
  const div = document.createElement('div');
  div.className = 'exp-entry';
  div.style.cssText = 'border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-bottom:12px; position:relative;';
  div.innerHTML = `
    <button type="button" class="btn btn-danger btn-sm" style="position:absolute; top:8px; right:8px;" onclick="this.parentElement.remove()">X</button>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
      <div class="form-group">
        <label><%= t('cv.jobTitle') %></label>
        <input type="text" class="exp-title" value="${escAttr(data.title)}">
      </div>
      <div class="form-group">
        <label><%= t('cv.company') %></label>
        <input type="text" class="exp-company" value="${escAttr(data.company)}">
      </div>
    </div>
    <div class="form-group">
      <label><%= t('cv.dates') %></label>
      <input type="text" class="exp-dates" value="${escAttr(data.dates)}">
    </div>
    <div class="form-group">
      <label><%= t('cv.description') %></label>
      <textarea class="exp-description" rows="3" placeholder="<%= t('cv.descriptionPlaceholder') %>">${escAttr(data.description)}</textarea>
    </div>
  `;
  return div;
}

function createEduEntry(data = {}) {
  const div = document.createElement('div');
  div.className = 'edu-entry';
  div.style.cssText = 'border:1px solid var(--border); border-radius:var(--radius); padding:16px; margin-bottom:12px; position:relative;';
  div.innerHTML = `
    <button type="button" class="btn btn-danger btn-sm" style="position:absolute; top:8px; right:8px;" onclick="this.parentElement.remove()">X</button>
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
      <div class="form-group">
        <label><%= t('cv.degree') %></label>
        <input type="text" class="edu-degree" value="${data.degree || ''}">
      </div>
      <div class="form-group">
        <label><%= t('cv.school') %></label>
        <input type="text" class="edu-school" value="${data.school || ''}">
      </div>
    </div>
    <div class="form-group">
      <label><%= t('cv.dates') %></label>
      <input type="text" class="edu-dates" value="${data.dates || ''}">
    </div>
  `;
  return div;
}

function addExperience() {
  document.getElementById('experience-list').appendChild(createExpEntry());
}

function addEducation() {
  document.getElementById('education-list').appendChild(createEduEntry());
}

function collectFormData() {
  const experience = [];
  document.querySelectorAll('.exp-entry').forEach(entry => {
    const title = entry.querySelector('.exp-title')?.value?.trim() || '';
    const company = entry.querySelector('.exp-company')?.value?.trim() || '';
    const dates = entry.querySelector('.exp-dates')?.value?.trim() || '';
    const description = entry.querySelector('.exp-description')?.value?.trim() || '';
    if (title || company) {
      experience.push({ title, company, dates, description });
    }
  });

  const education = [];
  document.querySelectorAll('.edu-entry').forEach(entry => {
    const degree = entry.querySelector('.edu-degree')?.value?.trim() || '';
    const school = entry.querySelector('.edu-school')?.value?.trim() || '';
    const dates = entry.querySelector('.edu-dates')?.value?.trim() || '';
    if (degree || school) {
      education.push({ degree, school, dates });
    }
  });

  const skillsRaw = document.getElementById('cv-skills').value;
  const skills = skillsRaw.split(',').map(s => s.trim()).filter(Boolean);

  return {
    name: document.getElementById('cv-name').value.trim(),
    email: document.getElementById('cv-email').value.trim(),
    phone: document.getElementById('cv-phone').value.trim(),
    location: document.getElementById('cv-location').value.trim(),
    summary: document.getElementById('cv-summary').value.trim(),
    experience,
    education,
    skills,
  };
}

document.getElementById('cv-form').addEventListener('submit', function(e) {
  const data = collectFormData();
  document.getElementById('cv-data-field').value = JSON.stringify(data);
});
</script>

<%- include('../partials/footer') %>
