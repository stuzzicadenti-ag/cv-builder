<%- include('../partials/header') %>

<div class="fade-in-up" style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:12px;">
  <div class="page-header">
    <h1><%= t('cv.myCvs') %></h1>
    <p><%= cvs.length %> <%= cvs.length === 1 ? 'CV' : 'CVs' %></p>
  </div>
  <div style="display:flex; gap:8px;">
    <button type="button" class="btn btn-outline btn-sm" onclick="document.getElementById('import-modal').showModal()"><%= t('cv.importJson') %></button>
    <a href="/cv/new" class="btn btn-primary">+ <%= t('cv.newCv') %></a>
  </div>
</div>

<% if (cvs.length === 0) { %>
  <div class="card empty-state-card fade-in-up bg-glow">
    <span class="icon">&#128196;</span>
    <h2 style="margin-bottom:8px; font-size:1.2rem;"><%= t('cv.noCvs') %></h2>
    <p style="color:var(--text-muted); margin-bottom:20px; font-size:0.9rem;">Create your first CV to get started</p>
    <a href="/cv/new" class="btn btn-primary btn-lg"><%= t('cv.createFirst') %></a>
  </div>
<% } else { %>
  <div class="grid grid-3">
    <% for (const cv of cvs) { %>
      <div class="card cv-card card-interactive fade-in-up" style="padding:0; overflow:hidden;">
        <div class="cv-card-preview">
          <div class="cv-card-mini"></div>
        </div>
        <div class="cv-card-body">
          <h3 class="cv-card-title"><%= cv.title %></h3>
          <div class="cv-card-meta">
            <span><%= t('cv.updated') %> <%= new Date(cv.updatedAt).toLocaleDateString() %></span>
            <% if (cv.isPublic) { %>
              <span class="badge badge-success">Shared</span>
            <% } %>
          </div>

          <% if (cv.isPublic && cv.shareToken) { %>
            <div class="share-box">
              <div class="share-box-label">&#9989; <%= t('cv.shareActive') %></div>
              <a href="/cv/public/<%= cv.shareToken %>" style="color:var(--primary); font-size:0.78rem;"><%= t('cv.shareLink') %></a>
            </div>
          <% } %>

          <div class="cv-card-actions">
            <a href="/cv/edit/<%= cv.id %>" class="btn btn-outline btn-sm">&#9998; <%= t('cv.edit') %></a>
            <a href="/cv/preview/<%= cv.id %>" class="btn btn-outline btn-sm" target="_blank">&#128065; <%= t('cv.preview') %></a>
            <a href="/cv/pdf/<%= cv.id %>" class="btn btn-primary btn-sm" onclick="this.classList.add('btn-loading')">&#128196; <%= t('cv.downloadPdf') %></a>
          </div>
          <div class="cv-card-actions-secondary">
            <form method="POST" action="/cv/duplicate/<%= cv.id %>" style="display:inline;">
              <button type="submit" class="btn btn-ghost btn-sm"><%= t('cv.duplicate') %></button>
            </form>
            <a href="/cv/export/<%= cv.id %>" class="btn btn-ghost btn-sm"><%= t('cv.exportJson') %></a>
            <form method="POST" action="/cv/share/<%= cv.id %>" style="display:inline;">
              <button type="submit" class="btn btn-ghost btn-sm"><%= cv.isPublic ? t('cv.unshare') : t('cv.share') %></button>
            </form>
            <form method="POST" action="/cv/delete/<%= cv.id %>" style="display:inline;" onsubmit="return confirm('<%= t('cv.deleteConfirm') %>')">
              <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);"><%= t('cv.delete') %></button>
            </form>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<!-- Import CV from JSON modal -->
<dialog id="import-modal" style="max-width:540px; width:90%;">
  <div style="padding:24px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h2 style="margin:0;"><%= t('cv.importCv') %></h2>
      <button type="button" class="btn btn-ghost btn-sm" onclick="document.getElementById('import-modal').close()">&#10005;</button>
    </div>
    <p style="font-size:0.9rem; color:var(--text-muted); margin-bottom:16px;"><%= t('cv.importDesc') %></p>
    <form method="POST" action="/cv/import" id="import-form">
      <div class="form-group">
        <label for="import-file"><%= t('cv.importFile') %></label>
        <div class="file-upload">
          <span>&#128193; Choose a JSON file or drag & drop</span>
          <input type="file" id="import-file" accept=".json" onchange="handleImportFile(this)">
        </div>
        <textarea name="importData" id="import-data" rows="6" style="margin-top:10px; font-family:monospace; font-size:0.8rem;" placeholder='<%= t("cv.importPlaceholder") %>'></textarea>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('import-modal').close()"><%= t('cv.cancel') %></button>
        <button type="submit" class="btn btn-primary" onclick="this.classList.add('btn-loading')"><%= t('cv.importBtn') %></button>
      </div>
    </form>
  </div>
</dialog>

<script>
function handleImportFile(input) {
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    document.getElementById('import-data').value = e.target.result;
    // Show toast
    showToast('File loaded: ' + file.name, 'success');
  };
  reader.onerror = function() {
    showToast('Failed to read file', 'error');
  };
  reader.readAsText(file);
}

// Toast helper
function showToast(msg, type) {
  var container = document.querySelector('.toast-container');
  if (!container) {
    container = document.createElement('div');
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  var toast = document.createElement('div');
  toast.className = 'toast toast-' + (type || 'info');
  toast.textContent = msg;
  container.appendChild(toast);
  setTimeout(function() {
    toast.classList.add('toast-out');
    setTimeout(function() { toast.remove(); }, 300);
  }, 3000);
}
</script>

<%- include('../partials/footer') %>
