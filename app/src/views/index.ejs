<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CV Builder - Free Professional CV/Resume Builder | Europass, LaTeX, Typst</title>
  <meta name="description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads. Export to PDF in minutes.">
  <meta name="keywords" content="CV builder, resume builder, Europass, LaTeX CV, Typst CV, free CV, ATS optimized, professional resume">
  <meta name="author" content="Stuzzicadenti AG">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="CV Builder - Free Professional CV/Resume Builder">
  <meta property="og:description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads.">
  <meta property="og:site_name" content="CV Builder">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="CV Builder - Free Professional CV/Resume Builder">
  <meta name="twitter:description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads.">
  <meta name="theme-color" content="#7c5cfc">

  <!-- Schema.org Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "CV Builder",
    "description": "Free professional CV/resume builder supporting Europass, LaTeX, and Typst formats.",
    "sameAs": []
  }
  </script>

  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/landing.css">
</head>
<body class="landing">

  <!-- Navigation -->
  <nav class="l-navbar" id="navbar">
    <div class="l-nav-container">
      <a href="/" class="l-nav-logo">
        <span class="l-logo-icon">&#128196;</span> CV Builder
      </a>
      <input type="checkbox" id="nav-toggle" class="l-nav-toggle-checkbox" aria-label="Toggle navigation">
      <label for="nav-toggle" class="l-nav-toggle-label" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>
      <ul class="l-nav-links">
        <li><a href="#hero">Home</a></li>
        <li><a href="#templates">Templates</a></li>
        <li><a href="#formats">Formats</a></li>
        <li><a href="#pricing">Pricing</a></li>
        <li><a href="/faq">FAQ</a></li>
      </ul>
      <div class="l-nav-actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <% if (user.role === 'admin' || user.role === 'owner') { %>
            <a href="/admin" class="l-btn l-btn-ghost" style="color:#a78bfa;">Admin</a>
          <% } %>
          <a href="/cv" class="l-btn l-btn-ghost">My CVs</a>
          <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Create New CV</a>
        <% } else { %>
          <a href="/auth/login" class="l-btn l-btn-ghost">Login</a>
          <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Register</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="l-hero" id="hero">
    <div class="l-hero-bg-shapes">
      <div class="l-shape l-shape-1"></div>
      <div class="l-shape l-shape-2"></div>
      <div class="l-shape l-shape-3"></div>
    </div>
    <div class="l-container l-hero-content">
      <span class="l-badge l-badge-free">&#10003; 100% Free. No Ads</span>
      <h1 class="l-hero-title">
        <span class="l-logo-icon-large">&#128196;</span> CV Builder
      </h1>
      <p class="l-hero-tagline">Professional CVs in minutes.<br>Europass, LaTeX, Typst.</p>
      <p class="l-hero-sub">Create ATS-optimized, beautifully typeset resumes with zero cost. Your data stays in your browser.</p>
      <div class="l-hero-cta">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/cv/new" class="l-btn l-btn-primary l-btn-lg">Build Your CV &#8594;</a>
        <% } else { %>
          <a href="/auth/register" class="l-btn l-btn-primary l-btn-lg">Build Your CV &#8594;</a>
        <% } %>
        <a href="#how-it-works" class="l-btn l-btn-outline l-btn-lg">How It Works</a>
      </div>
      <div class="l-hero-formats">
        <span class="l-format-pill">Europass</span>
        <span class="l-format-pill">LaTeX</span>
        <span class="l-format-pill">Typst</span>
        <span class="l-format-pill">PDF</span>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="l-section" id="how-it-works">
    <div class="l-container">
      <h2 class="l-section-title">How It Works</h2>
      <p class="l-section-subtitle">Three simple steps to your perfect CV</p>
      <div class="l-steps-grid">
        <div class="l-step-card">
          <div class="l-step-number">1</div>
          <div class="l-step-icon">&#127912;</div>
          <h3>Choose a Template</h3>
          <p>Pick from our curated collection of professional templates, Europass, academic, creative, and more.</p>
        </div>
        <div class="l-step-card">
          <div class="l-step-number">2</div>
          <div class="l-step-icon">&#9997;&#65039;</div>
          <h3>Fill Your Info</h3>
          <p>Enter your experience, education, and skills. Our smart editor guides you through each section.</p>
        </div>
        <div class="l-step-card">
          <div class="l-step-number">3</div>
          <div class="l-step-icon">&#128229;</div>
          <h3>Download PDF</h3>
          <p>Export your polished CV as a pixel-perfect PDF, ready to send to employers worldwide.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Templates Gallery -->
  <section class="l-section l-section-dark" id="templates">
    <div class="l-container">
      <h2 class="l-section-title">Templates</h2>
      <p class="l-section-subtitle">Professional designs for every career stage</p>
      <div class="l-templates-grid">

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header"></div>
              <div class="l-preview-sidebar"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
            <span class="l-template-badge">Popular</span>
          </div>
          <div class="l-template-info">
            <h3>Europass 2024</h3>
            <p>The EU standard format, recognized by employers and institutions across Europe.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-center"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
          </div>
          <div class="l-template-info">
            <h3>Modern Minimal</h3>
            <p>Clean, elegant design with plenty of whitespace. Perfect for tech and creative roles.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-left"></div>
              <div class="l-preview-lines dense">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
            <span class="l-template-badge l-badge-latex">LaTeX</span>
          </div>
          <div class="l-template-info">
            <h3>Academic LaTeX</h3>
            <p>Publication-quality typesetting for researchers, professors, and PhD candidates.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-split"></div>
              <div class="l-preview-columns">
                <div class="l-preview-col">
                  <div class="l-preview-line"></div>
                  <div class="l-preview-line short"></div>
                </div>
                <div class="l-preview-col">
                  <div class="l-preview-line"></div>
                  <div class="l-preview-line short"></div>
                </div>
              </div>
            </div>
            <span class="l-template-badge l-badge-typst">Typst</span>
          </div>
          <div class="l-template-info">
            <h3>Creative Typst</h3>
            <p>Modern two-column layout with color accents. Stand out in design and marketing roles.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-tech"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
              </div>
            </div>
          </div>
          <div class="l-template-info">
            <h3>Tech Professional</h3>
            <p>Skills-focused layout with technical proficiency bars. Ideal for engineers and developers.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-exec"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
              </div>
            </div>
            <span class="l-template-badge l-badge-new">New</span>
          </div>
          <div class="l-template-info">
            <h3>Executive</h3>
            <p>Sophisticated serif design for senior leadership, C-suite, and board-level positions.</p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm">Use Template</a>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Supported Formats -->
  <section class="l-section" id="formats">
    <div class="l-container">
      <h2 class="l-section-title">Supported Formats</h2>
      <p class="l-section-subtitle">Every format you need, all in one place</p>
      <div class="l-formats-grid">
        <div class="l-format-card">
          <div class="l-format-icon">&#127466;&#127482;</div>
          <h3>Europass</h3>
          <p>The EU standard CV format, recognized by employers and institutions across all member states.</p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#128209;</div>
          <h3>LaTeX</h3>
          <p>Pixel-perfect academic CVs with professional typesetting. The gold standard for research and academia.</p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#9889;</div>
          <h3>Typst</h3>
          <p>Modern typesetting that compiles in milliseconds. Clean syntax, beautiful output, blazing fast.</p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#128196;</div>
          <h3>PDF Export</h3>
          <p>One-click download to PDF. Print-ready, perfectly formatted, universally compatible.</p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#9989;</div>
          <h3>ATS-Optimized</h3>
          <p>Every template passes Applicant Tracking Systems. Your CV reaches human reviewers, not the spam folder.</p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#127760;</div>
          <h3>Multi-Language</h3>
          <p>Full support for English, Italian, German, French, and Spanish. Build CVs for international opportunities.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Free -->
  <section class="l-section l-section-dark" id="why-free">
    <div class="l-container">
      <h2 class="l-section-title">Why Free?</h2>
      <p class="l-section-subtitle">We believe everyone deserves a great CV</p>
      <div class="l-why-grid">
        <div class="l-why-card">
          <div class="l-why-icon">&#128187;</div>
          <h3>Open Source</h3>
          <p>Our core engine is open source. Inspect the code, contribute features, or self-host the entire application.</p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#128683;</div>
          <h3>No Ads, Ever</h3>
          <p>We will never show you ads, sell your data, or gate essential features behind paywalls.</p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#128274;</div>
          <h3>Privacy First</h3>
          <p>Your data stays in your browser. We don't store your personal information on our servers unless you opt in.</p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#129309;</div>
          <h3>Community Driven</h3>
          <p>Built by a community of developers and career professionals. Templates and features shaped by real user needs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="l-section" id="pricing">
    <div class="l-container">
      <h2 class="l-section-title">Plans &amp; Pricing</h2>
      <p class="l-section-subtitle">Start free, upgrade when you need more</p>
      <div class="l-pricing-grid">

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3>Self-Hosted</h3>
            <div class="l-pricing-price">Free <span>forever</span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; Download the app</li>
            <li>&#10003; Run locally on your machine</li>
            <li>&#10003; Write your own Typst/LaTeX</li>
            <li>&#10003; Full source code access</li>
            <li>&#10003; No account required</li>
            <li>&#10003; Complete privacy</li>
          </ul>
          <a href="#" class="l-btn l-btn-outline">Download</a>
        </div>

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3>Managed Free</h3>
            <div class="l-pricing-price">Free</div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; 1 CV</li>
            <li>&#10003; Basic templates</li>
            <li>&#10003; PDF export</li>
            <li>&#10003; ATS-optimized output</li>
            <li>&#10003; Browser-based editor</li>
            <li class="muted">&#10007; AI suggestions</li>
          </ul>
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/cv/new" class="l-btn l-btn-primary">Create CV</a>
          <% } else { %>
            <a href="/auth/register" class="l-btn l-btn-primary">Get Started</a>
          <% } %>
        </div>

        <div class="l-pricing-card l-pricing-featured">
          <span class="l-pricing-badge">Most Popular</span>
          <div class="l-pricing-header">
            <h3>Pro</h3>
            <div class="l-pricing-price">&euro;2.99<span>/month</span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; Unlimited CVs</li>
            <li>&#10003; All templates</li>
            <li>&#10003; AI-powered suggestions</li>
            <li>&#10003; Priority PDF export</li>
            <li>&#10003; Custom color themes</li>
            <li>&#10003; Version history</li>
          </ul>
          <a href="#" class="l-btn l-btn-primary">Start Pro Trial</a>
        </div>

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3>Enterprise</h3>
            <div class="l-pricing-price">&euro;49<span>/month</span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; Team management</li>
            <li>&#10003; Bulk CV generation</li>
            <li>&#10003; Custom branding</li>
            <li>&#10003; REST API access</li>
            <li>&#10003; Dedicated support</li>
            <li>&#10003; SSO / SAML</li>
          </ul>
          <a href="#" class="l-btn l-btn-outline">Contact Sales</a>
        </div>

      </div>

      <!-- One-time option -->
      <div class="l-one-time-box">
        <div class="l-one-time-content">
          <div class="l-one-time-icon">&#128269;</div>
          <div>
            <h3>Professional CV Review</h3>
            <p>Get your CV professionally reviewed by human experts. Detailed feedback on content, formatting, and ATS compatibility.</p>
          </div>
          <div class="l-one-time-price">
            <span class="price">&euro;4.99</span>
            <span class="price-label">per CV, one-time</span>
          </div>
          <a href="#" class="l-btn l-btn-primary">Get Reviewed</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Expert CV Writing -->
  <section class="l-section l-section-dark" id="cv-writing">
    <div class="l-container">
      <div class="l-writing-section">
        <div class="l-writing-content">
          <span class="l-badge l-badge-premium">&#11088; Premium Service</span>
          <h2>Expert CV Writing</h2>
          <p class="l-writing-tagline">Let our team write your CV from scratch</p>
          <p>Our professional CV writers have helped thousands of candidates land interviews at top companies. We craft compelling narratives that highlight your achievements and match your target roles.</p>
          <ul class="l-writing-features">
            <li>&#10003; One-on-one consultation with a career expert</li>
            <li>&#10003; Tailored to your target industry and role</li>
            <li>&#10003; ATS-optimized and recruiter-approved</li>
            <li>&#10003; Two rounds of revisions included</li>
            <li>&#10003; Delivered in PDF, LaTeX, and Typst formats</li>
          </ul>
          <div class="l-writing-price">
            Starting at <strong>&euro;29</strong>
          </div>
          <a href="#" class="l-btn l-btn-primary l-btn-lg">Get Your CV Written &#8594;</a>
        </div>
        <div class="l-writing-visual">
          <div class="l-writing-card-stack">
            <div class="l-writing-card-back"></div>
            <div class="l-writing-card-front">
              <div class="l-wc-header"></div>
              <div class="l-wc-line"></div>
              <div class="l-wc-line short"></div>
              <div class="l-wc-line"></div>
              <div class="l-wc-line short"></div>
              <div class="l-wc-badge">&#10003; Expert Written</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="l-section l-section-cta">
    <div class="l-container">
      <h2>Ready to Build Your CV?</h2>
      <p>Join thousands of professionals who trust CV Builder for their career documents.</p>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/cv/new" class="l-btn l-btn-primary l-btn-lg">Start Building. It's Free &#8594;</a>
      <% } else { %>
        <a href="/auth/register" class="l-btn l-btn-primary l-btn-lg">Start Building. It's Free &#8594;</a>
      <% } %>
    </div>
  </section>

  <!-- Footer -->
  <footer class="l-footer">
    <div class="l-container">
      <div class="l-footer-grid">
        <div class="l-footer-brand">
          <h3><span class="l-logo-icon">&#128196;</span> CV Builder</h3>
          <p>Free professional CV builder supporting Europass, LaTeX, and Typst formats. Open source, privacy-first, community-driven.</p>
        </div>
        <div class="l-footer-links">
          <h4>Product</h4>
          <ul>
            <li><a href="#templates">Templates</a></li>
            <li><a href="#formats">Formats</a></li>
            <li><a href="#pricing">Pricing</a></li>
            <li><a href="/faq">FAQ</a></li>
          </ul>
