<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CV Builder - Free Professional CV/Resume Builder | Europass, LaTeX, Typst</title>
  <meta name="description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads. Export to PDF in minutes.">
  <meta name="keywords" content="CV builder, resume builder, Europass, LaTeX CV, Typst CV, free CV, ATS optimized, professional resume">
  <meta name="author" content="Stuzzicadenti AG">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="CV Builder - Free Professional CV/Resume Builder">
  <meta property="og:description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads.">
  <meta property="og:site_name" content="CV Builder">
  <meta property="og:locale" content="en_US">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="CV Builder - Free Professional CV/Resume Builder">
  <meta name="twitter:description" content="Build professional CVs for free. Supports Europass, LaTeX, and Typst formats. ATS-optimized, privacy-first, no ads.">
  <meta name="theme-color" content="#7c5cfc">

  <!-- Schema.org Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "CV Builder",
    "description": "Free professional CV/resume builder supporting Europass, LaTeX, and Typst formats.",
    "sameAs": []
  }
  </script>

  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/landing.css">
</head>
<body class="landing">

  <!-- Navigation -->
  <nav class="l-navbar" id="navbar">
    <div class="l-nav-container">
      <a href="/" class="l-nav-logo">
        <span class="l-logo-icon">&#128196;</span> CV Builder
      </a>
      <input type="checkbox" id="nav-toggle" class="l-nav-toggle-checkbox" aria-label="Toggle navigation">
      <label for="nav-toggle" class="l-nav-toggle-label" aria-label="Menu">
        <span></span><span></span><span></span>
      </label>
      <ul class="l-nav-links">
        <li><a href="#hero"><%= t('nav.templates') === 'Templates' ? 'Home' : (lang === 'it' ? 'Home' : (lang === 'de' ? 'Home' : (lang === 'fr' ? 'Accueil' : 'Home'))) %></a></li>
        <li><a href="#templates"><%= t('nav.templates') %></a></li>
        <li><a href="#formats"><%= t('home.formats') %></a></li>
        <li><a href="#pricing"><%= t('home.pricing') %></a></li>
        <li><a href="/faq"><%= t('nav.faq') %></a></li>
      </ul>
      <div class="l-nav-actions">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="l-dd" style="position:relative;">
            <button type="button" class="l-btn l-btn-ghost l-dd-btn" style="gap:5px;">
              <%= user.name || user.email %> <span style="font-size:0.55rem;">&#9662;</span>
            </button>
            <div class="l-dd-menu">
              <a href="/cv"><%= t('nav.myCvs') %></a>
              <a href="/cv/new"><%= t('home.plan.createCv') %></a>
              <% if (user.role === 'admin' || user.role === 'owner') { %>
                <a href="/admin" style="color:#a78bfa;"><%= t('nav.admin') %></a>
              <% } %>
              <div style="height:1px;background:rgba(255,255,255,0.08);margin:4px 0;"></div>
              <a href="/auth/logout" style="color:#ef4444;"><%= t('nav.logout') || 'Logout' %></a>
            </div>
          </div>
        <% } else { %>
          <a href="/auth/login" class="l-btn l-btn-ghost"><%= t('nav.login') %></a>
          <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('nav.register') %></a>
        <% } %>
        <div class="l-dd" style="position:relative;">
          <button type="button" class="l-dd-btn" style="color:rgba(255,255,255,0.6);font-size:0.8rem;font-weight:700;letter-spacing:0.5px;padding:4px 8px;border:none;background:none;cursor:pointer;display:inline-flex;align-items:center;gap:4px;font-family:inherit;">
            <%= (typeof lang !== 'undefined' ? lang : 'en').toUpperCase() %> <span style="font-size:0.55rem;">&#9662;</span>
          </button>
          <div class="l-dd-menu" style="min-width:100px;">
            <a href="/lang/en" class="<%= lang === 'en' ? 'active' : '' %>">EN</a>
            <a href="/lang/it" class="<%= lang === 'it' ? 'active' : '' %>">IT</a>
            <a href="/lang/de" class="<%= lang === 'de' ? 'active' : '' %>">DE</a>
            <a href="/lang/fr" class="<%= lang === 'fr' ? 'active' : '' %>">FR</a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="l-hero" id="hero">
    <div class="l-hero-bg-shapes">
      <div class="l-shape l-shape-1"></div>
      <div class="l-shape l-shape-2"></div>
      <div class="l-shape l-shape-3"></div>
    </div>
    <div class="l-container l-hero-content">
      <span class="l-badge l-badge-free">&#10003; <%= t('home.badge') %></span>
      <h1 class="l-hero-title">
        <span class="l-logo-icon-large">&#128196;</span> CV Builder
      </h1>
      <p class="l-hero-tagline"><%- t('home.tagline') %></p>
      <p class="l-hero-sub"><%= t('home.sub') %></p>
      <div class="l-hero-cta">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/cv/new" class="l-btn l-btn-primary l-btn-lg"><%= t('home.cta') %> &#8594;</a>
        <% } else { %>
          <a href="/auth/register" class="l-btn l-btn-primary l-btn-lg"><%= t('home.cta') %> &#8594;</a>
        <% } %>
        <a href="#how-it-works" class="l-btn l-btn-outline l-btn-lg"><%= t('home.howItWorks') %></a>
      </div>
      <div class="l-hero-formats">
        <span class="l-format-pill">Europass</span>
        <span class="l-format-pill">LaTeX</span>
        <span class="l-format-pill">Typst</span>
        <span class="l-format-pill">PDF</span>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="l-section" id="how-it-works">
    <div class="l-container">
      <h2 class="l-section-title"><%= t('home.howItWorks') %></h2>
      <p class="l-section-subtitle"><%= t('home.howItWorksSubtitle') %></p>
      <div class="l-steps-grid">
        <div class="l-step-card">
          <div class="l-step-number">1</div>
          <div class="l-step-icon">&#127912;</div>
          <h3><%= t('home.step1.title') %></h3>
          <p><%= t('home.step1.desc') %></p>
        </div>
        <div class="l-step-card">
          <div class="l-step-number">2</div>
          <div class="l-step-icon">&#9997;&#65039;</div>
          <h3><%= t('home.step2.title') %></h3>
          <p><%= t('home.step2.desc') %></p>
        </div>
        <div class="l-step-card">
          <div class="l-step-number">3</div>
          <div class="l-step-icon">&#128229;</div>
          <h3><%= t('home.step3.title') %></h3>
          <p><%= t('home.step3.desc') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Templates Gallery -->
  <section class="l-section l-section-dark" id="templates">
    <div class="l-container">
      <h2 class="l-section-title"><%= t('home.templates') %></h2>
      <p class="l-section-subtitle"><%= t('home.templatesSubtitle') %></p>
      <div class="l-templates-grid">

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header"></div>
              <div class="l-preview-sidebar"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
            <span class="l-template-badge"><%= t('home.popular') %></span>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.europass.title') %></h3>
            <p><%= t('home.tpl.europass.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-center"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.modern.title') %></h3>
            <p><%= t('home.tpl.modern.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-left"></div>
              <div class="l-preview-lines dense">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
              </div>
            </div>
            <span class="l-template-badge l-badge-latex">LaTeX</span>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.latex.title') %></h3>
            <p><%= t('home.tpl.latex.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-split"></div>
              <div class="l-preview-columns">
                <div class="l-preview-col">
                  <div class="l-preview-line"></div>
                  <div class="l-preview-line short"></div>
                </div>
                <div class="l-preview-col">
                  <div class="l-preview-line"></div>
                  <div class="l-preview-line short"></div>
                </div>
              </div>
            </div>
            <span class="l-template-badge l-badge-typst">Typst</span>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.typst.title') %></h3>
            <p><%= t('home.tpl.typst.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-tech"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
              </div>
            </div>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.tech.title') %></h3>
            <p><%= t('home.tpl.tech.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

        <div class="l-template-card">
          <div class="l-template-preview">
            <div class="l-template-preview-content">
              <div class="l-preview-header-exec"></div>
              <div class="l-preview-lines">
                <div class="l-preview-line"></div>
                <div class="l-preview-line short"></div>
                <div class="l-preview-line"></div>
              </div>
            </div>
            <span class="l-template-badge l-badge-new"><%= t('home.new') %></span>
          </div>
          <div class="l-template-info">
            <h3><%= t('home.tpl.exec.title') %></h3>
            <p><%= t('home.tpl.exec.desc') %></p>
            <% if (typeof user !== 'undefined' && user) { %>
              <a href="/cv/new" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } else { %>
              <a href="/auth/register" class="l-btn l-btn-primary l-btn-sm"><%= t('home.useTemplate') %></a>
            <% } %>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Supported Formats -->
  <section class="l-section" id="formats">
    <div class="l-container">
      <h2 class="l-section-title"><%= t('home.formats') %></h2>
      <p class="l-section-subtitle"><%= t('home.formatsSubtitle') %></p>
      <div class="l-formats-grid">
        <div class="l-format-card">
          <div class="l-format-icon">&#127466;&#127482;</div>
          <h3><%= t('home.fmt.europass') %></h3>
          <p><%= t('home.fmt.europass.desc') %></p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#128209;</div>
          <h3><%= t('home.fmt.latex') %></h3>
          <p><%= t('home.fmt.latex.desc') %></p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#9889;</div>
          <h3><%= t('home.fmt.typst') %></h3>
          <p><%= t('home.fmt.typst.desc') %></p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#128196;</div>
          <h3><%= t('home.fmt.pdf') %></h3>
          <p><%= t('home.fmt.pdf.desc') %></p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#9989;</div>
          <h3><%= t('home.fmt.ats') %></h3>
          <p><%= t('home.fmt.ats.desc') %></p>
        </div>
        <div class="l-format-card">
          <div class="l-format-icon">&#127760;</div>
          <h3><%= t('home.fmt.multilang') %></h3>
          <p><%= t('home.fmt.multilang.desc') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Free -->
  <section class="l-section l-section-dark" id="why-free">
    <div class="l-container">
      <h2 class="l-section-title"><%= t('home.whyFree') %></h2>
      <p class="l-section-subtitle"><%= t('home.whyFreeSubtitle') %></p>
      <div class="l-why-grid">
        <div class="l-why-card">
          <div class="l-why-icon">&#128187;</div>
          <h3><%= t('home.why.openSource') %></h3>
          <p><%= t('home.why.openSource.desc') %></p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#128683;</div>
          <h3><%= t('home.why.noAds') %></h3>
          <p><%= t('home.why.noAds.desc') %></p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#128274;</div>
          <h3><%= t('home.why.privacy') %></h3>
          <p><%= t('home.why.privacy.desc') %></p>
        </div>
        <div class="l-why-card">
          <div class="l-why-icon">&#129309;</div>
          <h3><%= t('home.why.community') %></h3>
          <p><%= t('home.why.community.desc') %></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="l-section" id="pricing">
    <div class="l-container">
      <h2 class="l-section-title"><%= t('home.pricing') %></h2>
      <p class="l-section-subtitle"><%= t('home.pricingSubtitle') %></p>
      <div class="l-pricing-grid">

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3><%= t('home.plan.selfHosted') %></h3>
            <div class="l-pricing-price"><%= t('home.plan.free') %> <span><%= t('home.plan.forever') %></span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; <%= t('home.plan.selfHosted.f1') %></li>
            <li>&#10003; <%= t('home.plan.selfHosted.f2') %></li>
            <li>&#10003; <%= t('home.plan.selfHosted.f3') %></li>
            <li>&#10003; <%= t('home.plan.selfHosted.f4') %></li>
            <li>&#10003; <%= t('home.plan.selfHosted.f5') %></li>
            <li>&#10003; <%= t('home.plan.selfHosted.f6') %></li>
          </ul>
          <a href="#" class="l-btn l-btn-outline"><%= t('home.plan.download') %></a>
        </div>

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3><%= t('home.plan.managedFree') %></h3>
            <div class="l-pricing-price"><%= t('home.plan.free') %></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; <%= t('home.plan.managedFree.f1') %></li>
            <li>&#10003; <%= t('home.plan.managedFree.f2') %></li>
            <li>&#10003; <%= t('home.plan.managedFree.f3') %></li>
            <li>&#10003; <%= t('home.plan.managedFree.f4') %></li>
            <li>&#10003; <%= t('home.plan.managedFree.f5') %></li>
            <li class="muted">&#10007; <%= t('home.plan.managedFree.f6') %></li>
          </ul>
          <% if (typeof user !== 'undefined' && user) { %>
            <a href="/cv/new" class="l-btn l-btn-primary"><%= t('home.plan.createCv') %></a>
          <% } else { %>
            <a href="/auth/register" class="l-btn l-btn-primary"><%= t('home.plan.getStarted') %></a>
          <% } %>
        </div>

        <div class="l-pricing-card l-pricing-featured">
          <span class="l-pricing-badge"><%= t('home.plan.mostPopular') %></span>
          <div class="l-pricing-header">
            <h3><%= t('home.plan.pro') %></h3>
            <div class="l-pricing-price">&euro;2.99<span><%= t('home.plan.pro.price') %></span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; <%= t('home.plan.pro.f1') %></li>
            <li>&#10003; <%= t('home.plan.pro.f2') %></li>
            <li>&#10003; <%= t('home.plan.pro.f3') %></li>
            <li>&#10003; <%= t('home.plan.pro.f4') %></li>
            <li>&#10003; <%= t('home.plan.pro.f5') %></li>
            <li>&#10003; <%= t('home.plan.pro.f6') %></li>
          </ul>
          <a href="#" class="l-btn l-btn-primary"><%= t('home.plan.startTrial') %></a>
        </div>

        <div class="l-pricing-card">
          <div class="l-pricing-header">
            <h3><%= t('home.plan.enterprise') %></h3>
            <div class="l-pricing-price">&euro;49<span><%= t('home.plan.enterprise.price') %></span></div>
          </div>
          <ul class="l-pricing-features">
            <li>&#10003; <%= t('home.plan.enterprise.f1') %></li>
            <li>&#10003; <%= t('home.plan.enterprise.f2') %></li>
            <li>&#10003; <%= t('home.plan.enterprise.f3') %></li>
            <li>&#10003; <%= t('home.plan.enterprise.f4') %></li>
            <li>&#10003; <%= t('home.plan.enterprise.f5') %></li>
            <li>&#10003; <%= t('home.plan.enterprise.f6') %></li>
          </ul>
          <a href="#" class="l-btn l-btn-outline"><%= t('home.plan.contactSales') %></a>
        </div>

      </div>

      <!-- One-time option -->
      <div class="l-one-time-box">
        <div class="l-one-time-content">
          <div class="l-one-time-icon">&#128269;</div>
          <div>
            <h3><%= t('home.review.title') %></h3>
            <p><%= t('home.review.desc') %></p>
          </div>
          <div class="l-one-time-price">
            <span class="price">&euro;4.99</span>
            <span class="price-label"><%= t('home.review.price') %></span>
          </div>
          <a href="#" class="l-btn l-btn-primary"><%= t('home.review.cta') %></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Expert CV Writing -->
  <section class="l-section l-section-dark" id="cv-writing">
    <div class="l-container">
      <div class="l-writing-section">
        <div class="l-writing-content">
          <span class="l-badge l-badge-premium">&#11088; <%= t('home.writing.badge') %></span>
          <h2><%= t('home.writing.title') %></h2>
          <p class="l-writing-tagline"><%= t('home.writing.tagline') %></p>
          <p><%= t('home.writing.desc') %></p>
          <ul class="l-writing-features">
            <li>&#10003; <%= t('home.writing.f1') %></li>
            <li>&#10003; <%= t('home.writing.f2') %></li>
            <li>&#10003; <%= t('home.writing.f3') %></li>
            <li>&#10003; <%= t('home.writing.f4') %></li>
            <li>&#10003; <%= t('home.writing.f5') %></li>
          </ul>
          <div class="l-writing-price">
            <%= t('home.writing.startingAt') %> <strong>&euro;29</strong>
          </div>
          <a href="#" class="l-btn l-btn-primary l-btn-lg"><%= t('home.writing.cta') %> &#8594;</a>
        </div>
        <div class="l-writing-visual">
          <div class="l-writing-card-stack">
            <div class="l-writing-card-back"></div>
            <div class="l-writing-card-front">
              <div class="l-wc-header"></div>
              <div class="l-wc-line"></div>
              <div class="l-wc-line short"></div>
              <div class="l-wc-line"></div>
              <div class="l-wc-line short"></div>
              <div class="l-wc-badge">&#10003; <%= t('home.writing.badge2') %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="l-section l-section-cta">
    <div class="l-container">
      <h2><%= t('home.cta.ready') %></h2>
      <p><%= t('home.cta.join') %></p>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/cv/new" class="l-btn l-btn-primary l-btn-lg"><%= t('home.cta.start') %> &#8594;</a>
      <% } else { %>
        <a href="/auth/register" class="l-btn l-btn-primary l-btn-lg"><%= t('home.cta.start') %> &#8594;</a>
      <% } %>
    </div>
  </section>

  <!-- Footer -->
  <footer class="l-footer">
    <div class="l-container">
      <div class="l-footer-grid">
        <div class="l-footer-brand">
          <h3><span class="l-logo-icon">&#128196;</span> CV Builder</h3>
          <p><%= t('footer.brand.desc') %></p>
        </div>
        <div class="l-footer-links">
          <h4><%= t('footer.product') %></h4>
          <ul>
            <li><a href="#templates"><%= t('nav.templates') %></a></li>
            <li><a href="#formats"><%= t('home.formats') %></a></li>
            <li><a href="#pricing"><%= t('home.pricing') %></a></li>
            <li><a href="/faq"><%= t('nav.faq') %></a></li>
          </ul>
        </div>
        <div class="l-footer-links">
          <h4><%= t('footer.company') %></h4>
          <ul>
            <li><a href="#"><%= t('footer.about') %></a></li>
            <li><a href="#"><%= t('footer.blog') %></a></li>
            <li><a href="#"><%= t('footer.careers') %></a></li>
            <li><a href="#"><%= t('footer.contact') %></a></li>
          </ul>
        </div>
        <div class="l-footer-links">
          <h4><%= t('footer.legal') %></h4>
          <ul>
            <li><a href="#"><%= t('footer.privacy') %></a></li>
            <li><a href="#"><%= t('footer.terms') %></a></li>
            <li><a href="#"><%= t('footer.cookies') %></a></li>
            <li><a href="#"><%= t('footer.gdpr') %></a></li>
          </ul>
        </div>
      </div>
      <div class="l-footer-bottom">
        <p>&copy; 2026 <%= t('footer.copyright') %></p>
        <p class="l-footer-privacy"><%= t('footer.privacyNote') %></p>
      </div>
    </div>
  </footer>

  <script>
    // Navbar scroll effect
    (function() {
      window.addEventListener('scroll', function() {
        document.getElementById('navbar').classList.toggle('scrolled', window.scrollY > 50);
      });
    })();
  </script>

<script>
(function(){
  document.querySelectorAll('.l-dd-btn').forEach(function(btn){
    btn.addEventListener('click',function(e){
      e.stopPropagation();
      var dd=btn.closest('.l-dd');
      var open=dd.classList.contains('open');
      document.querySelectorAll('.l-dd.open').forEach(function(d){d.classList.remove('open');});
      if(!open)dd.classList.add('open');
    });
  });
  document.addEventListener('click',function(){
    document.querySelectorAll('.l-dd.open').forEach(function(d){d.classList.remove('open');});
  });
})();
</script>
</body>
</html>
