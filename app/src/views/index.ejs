<%- include('partials/header') %>

<div style="text-align:center; padding: 60px 0;">
  <h1 style="font-size: 2.5rem; margin-bottom: 16px;">Build Your Perfect CV</h1>
  <p style="color: var(--text-muted); font-size: 1.1rem; margin-bottom: 32px;">Choose a template, fill in your details, download a professional PDF. Free and open source.</p>
  <% if (user) { %>
    <a href="/cv/new" class="btn btn-primary" style="font-size:1rem; padding:12px 32px;">Create New CV</a>
    <a href="/cv" class="btn btn-outline" style="font-size:1rem; padding:12px 32px; margin-left:12px;">My CVs</a>
  <% } else { %>
    <a href="/auth/register" class="btn btn-primary" style="font-size:1rem; padding:12px 32px;">Get Started Free</a>
  <% } %>
</div>

<h2 style="margin-bottom: 20px;">Templates</h2>
<div class="grid grid-3" id="templates-preview"></div>

<%- include('partials/footer') %>
