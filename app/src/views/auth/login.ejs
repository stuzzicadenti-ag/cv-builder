<%- include('../partials/header') %>

<div class="bg-glow" style="max-width: 420px; margin: 48px auto;">
  <div class="fade-in-up" style="text-align:center; margin-bottom:24px;">
    <div style="font-size:2.5rem; margin-bottom:8px;">&#128196;</div>
    <h2 style="margin-bottom:4px; background: linear-gradient(135deg, var(--text) 0%, var(--primary-light) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"><%= t('auth.login') %></h2>
    <p style="color:var(--text-muted); font-size:0.88rem;">Welcome back to CV Builder</p>
  </div>
  <div class="card auth-card fade-in-up">
    <% if (error) { %><div class="alert alert-error">&#9888; <%= error %></div><% } %>
    <% if (typeof registered !== 'undefined' && registered) { %>
      <div class="alert alert-success">&#9989; <%= t('auth.registered') %></div>
    <% } %>
    <form method="POST" action="/auth/login" id="login-form">
      <div class="form-group">
        <label for="email"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" required placeholder="<%= t('auth.emailPlaceholder') %>" autocomplete="email">
      </div>
      <div class="form-group">
        <label for="password"><%= t('auth.password') %></label>
        <input type="password" id="password" name="password" required placeholder="<%= t('auth.passwordPlaceholder') %>" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary btn-lg" style="width:100%;" id="login-btn"><%= t('auth.loginBtn') %></button>
    </form>
    <p style="text-align:center; margin-top:16px; font-size:0.85rem; color:var(--text-muted);">
      <%= t('auth.noAccount') %> <a href="/auth/register"><%= t('auth.registerHere') %></a>
    </p>
  </div>
</div>

<script>
document.getElementById('login-form').addEventListener('submit', function() {
  document.getElementById('login-btn').classList.add('btn-loading');
});
</script>

<%- include('../partials/footer') %>
