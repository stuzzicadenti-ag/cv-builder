<%- include('../partials/header') %>

<div style="max-width: 400px; margin: 40px auto;">
  <div class="card">
    <h2 style="margin-bottom: 20px;"><%= t('auth.register') %></h2>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/auth/register">
      <div class="form-group">
        <label for="name"><%= t('auth.fullName') %></label>
        <input type="text" id="name" name="name" required placeholder="<%= t('auth.namePlaceholder') %>">
      </div>
      <div class="form-group">
        <label for="email"><%= t('auth.email') %></label>
        <input type="email" id="email" name="email" required placeholder="<%= t('auth.emailPlaceholder') %>">
      </div>
      <div class="form-group">
        <label for="password"><%= t('auth.password') %></label>
        <input type="password" id="password" name="password" required minlength="8" placeholder="<%= t('auth.passwordMin') %>">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('auth.createAccount') %></button>
    </form>
    <p style="text-align:center; margin-top:16px; font-size:0.85rem; color:var(--text-muted);">
      <%= t('auth.haveAccount') %> <a href="/auth/login"><%= t('auth.loginHere') %></a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
