<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CV Builder</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/landing.css">
</head>
<body>
<nav>
  <div class="container">
    <a href="/" class="nav-brand">CV<span>Builder</span></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <div class="nav-links">
      <a href="/templates">Templates</a>
      <a href="/faq">FAQ</a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/cv">My CVs</a>
        <% if (user.role === 'admin' || user.role === 'owner') { %>
          <a href="/admin" style="color:#a78bfa;">Admin</a>
        <% } %>
        <a href="/auth/logout">Logout</a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline btn-sm">Login</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Register</a>
      <% } %>
    </div>
  </div>
</nav>
<main><div class="container">
