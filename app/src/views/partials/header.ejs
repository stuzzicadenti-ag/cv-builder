<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | CV Builder</title>
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
  <link rel="stylesheet" href="/public/style.css">
  <link rel="stylesheet" href="/public/landing.css">
</head>
<body>
<nav>
  <div class="container">
    <a href="/" class="nav-brand">CV<span>Builder</span></a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" aria-label="Toggle navigation">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Menu">
      <span></span><span></span><span></span>
    </label>
    <div class="nav-links">
      <a href="/templates"><%= typeof t !== 'undefined' ? t('nav.templates') : 'Templates' %></a>
      <a href="/faq"><%= typeof t !== 'undefined' ? t('nav.faq') : 'FAQ' %></a>
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/cv"><%= typeof t !== 'undefined' ? t('nav.myCvs') : 'My CVs' %></a>
        <% if (user.role === 'admin' || user.role === 'owner') { %>
          <a href="/admin" style="color:#a78bfa;"><%= typeof t !== 'undefined' ? t('nav.admin') : 'Admin' %></a>
        <% } %>
        <a href="/auth/logout"><%= typeof t !== 'undefined' ? t('nav.logout') : 'Logout' %></a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline btn-sm"><%= typeof t !== 'undefined' ? t('nav.login') : 'Login' %></a>
        <a href="/auth/register" class="btn btn-primary btn-sm"><%= typeof t !== 'undefined' ? t('nav.register') : 'Register' %></a>
      <% } %>
      <span style="font-size:0.75rem; margin-left:8px;"><a href="/lang/en" style="opacity:<%= (typeof lang !== 'undefined' && lang === 'en') ? '1' : '0.5' %>">EN</a> | <a href="/lang/it" style="opacity:<%= (typeof lang !== 'undefined' && lang === 'it') ? '1' : '0.5' %>">IT</a> | <a href="/lang/de" style="opacity:<%= (typeof lang !== 'undefined' && lang === 'de') ? '1' : '0.5' %>">DE</a> | <a href="/lang/fr" style="opacity:<%= (typeof lang !== 'undefined' && lang === 'fr') ? '1' : '0.5' %>">FR</a></span>
    </div>
  </div>
</nav>
<main><div class="container">
