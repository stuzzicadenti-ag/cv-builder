<%- include('partials/header') %>

<style>
  .faq-page { max-width: 720px; margin: 0 auto; padding: 40px 0; }
  .faq-page > h1 { font-size: 1.8rem; font-weight: 700; margin-bottom: 8px; }
  .faq-page .faq-subtitle { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 32px; }
  .faq-section { margin-bottom: 28px; }
  .faq-section > h2 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .faq-item {
    margin-bottom: 4px;
  }
  .faq-item details {
    border: 1px solid var(--border-subtle, var(--border));
    border-radius: var(--radius);
    margin-top: 0;
    background: var(--surface);
  }
  .faq-item details[open] {
    border-color: var(--border);
  }
  .faq-item details summary {
    padding: 12px 16px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s;
  }
  .faq-item details summary:hover {
    background: rgba(255,255,255,0.02);
  }
  .faq-item details summary::-webkit-details-marker { display: none; }
  .faq-item details summary::before {
    content: '';
    width: 0;
    height: 0;
    border-left: 5px solid var(--primary);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .faq-item details[open] summary::before {
    transform: rotate(90deg);
  }
  .faq-item details > div {
    padding: 0 16px 14px;
    border-top: none;
  }
  .faq-item details > div p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
  .faq-contact {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg, var(--radius));
    padding: 28px;
    text-align: center;
    margin-top: 40px;
  }
  .faq-contact h2 { font-size: 1.1rem; margin-bottom: 8px; border: none; padding: 0; }
  .faq-contact p { font-size: 0.88rem; color: var(--text-muted); margin-bottom: 14px; }
</style>

